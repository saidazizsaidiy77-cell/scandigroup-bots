# ── Baza ───────────────────────────────────────────────────────────────────
# Railway / Neon / Supabase bergan ulanish satri
DATABASE_URL=postgresql://user:parol@host:5432/dbname
# Lokal Postgres uchun (SSL yo'q) — serverda bu qatorni QO'YMANG
# PGSSL=off

# ── ERP ────────────────────────────────────────────────────────────────────
PORT=3000
SESSION_DAYS=30
# Server ko'tarilishida bazani o'zi yaratadi/yangilaydi (Railway, Render uchun qulay)
ERP_AUTO_MIGRATE=1

# ── Telegram ───────────────────────────────────────────────────────────────
# Mini App imzosini tekshirish uchun. Mavjud HR bot tokeni ishlatilsa bo'ladi.
HR_BOT_TOKEN=
# Yoki ERP uchun alohida bot ochilsa:
# ERP_BOT_TOKEN=

# ── Mavjud botlar ──────────────────────────────────────────────────────────
CANDIDATE_BOT_TOKEN=
SUPER_ADMIN_ID=
MINI_APP_URL=

# ── Shaxsiy pul boti (npm run pul) ─────────────────────────────────────────
# @BotFather dan ALOHIDA bot oching — ERP va HR botlari bilan aralashmasin
PUL_BOT_TOKEN=
# Kim ishlata oladi: Telegram ID lar, vergul bilan (botga /start yozsangiz ID ni aytadi)
PUL_BOT_USERS=
# Mintaqa va kechki xulosa vaqti (bo'sh qoldirilsa xulosa yuborilmaydi)
PUL_TZ=Asia/Tashkent
PUL_DAILY_AT=21:00
